<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.DerpyOwl" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/owl_night</item>
        <item name="android:navigationBarColor">@color/owl_night</item>
        <item name="windowSplashScreenBackground">@color/owl_night</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.DerpyOwl.Base</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <style name="Theme.DerpyOwl.Base" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/owl_night</item>
        <item name="android:navigationBarColor">@color/owl_night</item>
        <item name="android:windowBackground">@color/owl_sky</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>
</resources>
